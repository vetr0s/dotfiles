#!/usr/bin/env bash

set -eu

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
packages="bash clang-format doom git karabiner kitty launchd nvim scripts tmux vim"

usage() {
  cat <<EOF
Usage: ./setup-macos --dry-run | --install

  --dry-run  Check tools and Stow conflicts without changing the machine.
  --install  Install Brewfile entries and link every macOS Stow package.

System preferences remain separate. Run macos-desktop-settings apply explicitly.
EOF
}

check_host() {
  if [ "$(uname -s)" != Darwin ]; then
    printf 'This setup requires macOS.\n' >&2
    exit 1
  fi
  if [ "$(uname -m)" != arm64 ]; then
    printf 'Warning: this setup is tested on Apple Silicon.\n' >&2
  fi
}

dry_run() {
  command -v brew >/dev/null 2>&1 || { printf 'Homebrew is not installed.\n' >&2; exit 1; }
  command -v stow >/dev/null 2>&1 || { printf 'GNU Stow is not installed.\n' >&2; exit 1; }
  brew bundle check --verbose --no-upgrade --file "$repo_dir/Brewfile" || true
  stow --no --verbose=1 --dir="$repo_dir" --target="$HOME" $packages
}

install() {
  command -v brew >/dev/null 2>&1 || { printf 'Install Homebrew first.\n' >&2; exit 1; }
  brew bundle --file "$repo_dir/Brewfile"
  # Neovim's Rust LSP. The toolchain itself comes from rustup, not Homebrew.
  if command -v rustup >/dev/null 2>&1; then
    rustup component add rust-analyzer
  fi
  stow --no --verbose=1 --dir="$repo_dir" --target="$HOME" $packages
  stow --verbose=1 --dir="$repo_dir" --target="$HOME" $packages
  printf 'Installed and linked the macOS desktop files.\n'
}

check_host

case "${1:-}" in
  --dry-run) dry_run ;;
  --install) install ;;
  *) usage; exit 2 ;;
esac
