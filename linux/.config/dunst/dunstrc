[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 140)
    origin = top-right
    offset = (18, 58)
    notification_limit = 5
    frame_width = 2
    frame_color = "#7aa2f7"
    corner_radius = 10
    font = Monospace 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    max_icon_size = 48
    separator_color = frame
    padding = 12
    horizontal_padding = 14

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
