" A small, predictable Vim for terminals and remote sessions.
syntax enable
filetype plugin indent on

set number
set cursorline
set scrolloff=3

set ignorecase
set smartcase
set incsearch
set hlsearch

set backspace=indent,eol,start
set autoindent
set splitbelow
set splitright

set wildmenu
set wildmode=longest:full,full

set mouse=
set belloff=all
set nomodeline
set background=dark
